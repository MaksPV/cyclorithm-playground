// Высоты ударных.
const KICK_F = 55;
const SNARE_F = 180;
const HAT_F = 9000;
const HAT2_F = 9500;
const CLAP_F = 1000;
const TOM_LO_F = 110;
const TOM_HI_F = 147;
const RIM_F = 800;
const CRASH_F = 6500;
const RIDE_F = 5200;

// Интервалы вверх от любой частоты: FIFTH(A2) — квинта от ля.
// Am тремя голосами: A2 + MIN3(A2) + FIFTH(A2).
fun OCT(x) = x * 2;
fun OCTD(x) = x / 2;
fun SEMI(x) = x * 1.059463;
fun TONE(x) = x * 1.122462;
fun MIN3(x) = x * 1.189207;
fun MAJ3(x) = x * 1.259921;
fun FOURTH(x) = x * 1.334840;
fun FIFTH(x) = x * 1.498307;
fun MIN6(x) = x * 1.587401;
fun MAJ6(x) = x * 1.681793;
fun MIN7(x) = x * 1.781797;
fun MAJ7(x) = x * 1.887749;

// Гаммы: доступ по индексу — {"freq": AM_PENT[4]}.
const AM_MIN = [A2, B2, C3, D3, E3, F3, G3, A3, C4, D4, E4, G4, A4];
const AM_PENT = [A2, C3, D3, E3, G3, A3, C4, D4, E4, G4, A4];
const C_MAJ = [C3, D3, E3, F3, G3, A3, B3, C4, D4, E4, F4, G4, A4, B4, C5];

// Такт 2000мс (120 BPM, 4/4): четверти.
time_const GRID4 duration = 2000ms {
  q1: 0ms;
  q2: 500ms;
  q3: 1000ms;
  q4: 1500ms;
}

// Такт 2000мс: восьмые.
